# =============================================================================
# Enterprise AI Incident Resolution & Knowledge Copilot — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Runtime mode ---------------------------------------------------------
# "local"      -> SQLite + FAISS + deterministic dummy LLM (no external deps, no API keys)
# "production" -> PostgreSQL + Qdrant + real LLM provider
APP_ENV=local

# --- LLM provider abstraction ----------------------------------------------
# Supported: "dummy" (offline, deterministic, no key needed), "openai", "anthropic"
LLM_PROVIDER=dummy
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.1

# --- Embeddings --------------------------------------------------------
# Supported: "dummy" (offline hashing embedder), "openai", "sentence-transformers"
EMBEDDING_PROVIDER=dummy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# --- Database ------------------------------------------------------------
# local mode default (SQLite file, relative to project root):
DATABASE_URL=sqlite:///./data/local.db
# production example:
# DATABASE_URL=postgresql+psycopg2://copilot:changeme@postgres:5432/incident_copilot

# --- Vector store ----------------------------------------------------------
VECTOR_STORE_PROVIDER=faiss
# production example:
# VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
FAISS_INDEX_DIR=./data/vector_store

# --- API / server ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT_PER_MINUTE=60
API_AUTH_TOKEN=

# --- Observability -----------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
LOG_LEVEL=INFO

# --- Guardrails / limits -------------------------------------------------
MAX_AGENT_RETRIES=2
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.7
HUMAN_REVIEW_RISK_THRESHOLD=medium
